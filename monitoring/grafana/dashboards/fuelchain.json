{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus"}],
  "title": "FuelChain Guardian — Operations Dashboard",
  "uid": "fuelchain-main",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Active Tankers",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "count(vessel_tracker_messages_total)",
        "legendFormat": "Tankers"
      }],
      "options": {"colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}]}}}
    },
    {
      "id": 2, "type": "stat", "title": "Critical Pumps (RED)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "inventory_pumps_red_count",
        "legendFormat": "RED Pumps"
      }],
      "options": {"colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 15}]}}}
    },
    {
      "id": 3, "type": "stat", "title": "AIS Messages/s",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "rate(ais_producer_messages_total[1m])",
        "legendFormat": "msg/s"
      }],
      "options": {"colorMode": "background"}
    },
    {
      "id": 4, "type": "stat", "title": "Panic Classifications/min",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "rate(panic_nlp_classifications_total[1m]) * 60",
        "legendFormat": "per min"
      }],
      "options": {"colorMode": "background"}
    },
    {
      "id": 5, "type": "stat", "title": "Anomalies Detected",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "sum(anomaly_detector_events_total)",
        "legendFormat": "Total Anomalies"
      }],
      "options": {"colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 3}, {"color": "red", "value": 10}]}}}
    },
    {
      "id": 6, "type": "stat", "title": "WebSocket Connections",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "ws_gateway_active_connections",
        "legendFormat": "Connections"
      }],
      "options": {"colorMode": "background"}
    },
    {
      "id": 10, "type": "timeseries", "title": "HTTP Request Rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "rate(http_requests_total[1m])",
        "legendFormat": "{{method}} {{path}} ({{status}})"
      }],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 11, "type": "timeseries", "title": "API Latency (p95)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
        "legendFormat": "p95 latency"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 20, "type": "timeseries", "title": "Pump Inventory Status Over Time",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"datasource": {"type": "prometheus"}, "expr": "inventory_pumps_red_count", "legendFormat": "RED"},
        {"datasource": {"type": "prometheus"}, "expr": "inventory_pumps_yellow_count", "legendFormat": "YELLOW"}
      ]
    },
    {
      "id": 21, "type": "timeseries", "title": "Disruption Index by Port",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "disruption_index_value",
        "legendFormat": "{{port}}"
      }],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}
    },
    {
      "id": 30, "type": "timeseries", "title": "Panic Index by City",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "panic_index_value",
        "legendFormat": "{{city}}"
      }],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}
    },
    {
      "id": 31, "type": "timeseries", "title": "NLP Inference Latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [{
        "datasource": {"type": "prometheus"},
        "expr": "histogram_quantile(0.99, rate(panic_nlp_inference_seconds_bucket[5m]))",
        "legendFormat": "p99 inference"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ]
}

# ============================================================
# FuelChain Guardian — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ── AIS Data Source ───────────────────────────────────────────────────────
# Set AIS_MODE=aishub and provide your key for live vessel tracking
# Register at: https://www.aishub.net/api
AIS_MODE=simulator
AISHUB_API_KEY=

# ── Twitter / Social Media ────────────────────────────────────────────────
# Set SOCIAL_MODE=twitter and provide bearer token for real panic detection
# Get from: https://developer.twitter.com
SOCIAL_MODE=simulator
TWITTER_BEARER_TOKEN=

# ── Database ──────────────────────────────────────────────────────────────
# Leave as-is for Docker Compose; update for external DB
DATABASE_URL=postgresql+asyncpg://fuelchain:secret@postgres:5432/fuelchain

# ── Cache ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Kafka / Redpanda ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# ── Auth ──────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a random 256-bit secret in production!
JWT_SECRET=dev-secret-change-in-production-please-use-256-bits
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Payment Gateway ───────────────────────────────────────────────────────
# Set PAYMENT_MODE=live with real keys to enable actual UPI disbursals
# Get from: https://razorpay.com
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Firebase ──────────────────────────────────────────────────────────────
# Required for Flutter app push notifications
# Create a Firebase project and download service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=./secrets/firebase-service-account.json

# ── NLP Service ───────────────────────────────────────────────────────────
NLP_SERVICE_URL=http://panic-nlp:8001
MODEL_PATH=/app/models/panic_classifier

# ── Simulator Settings ────────────────────────────────────────────────────
# Pump inventory tick interval in seconds (1800 = 30 min)
TICK_INTERVAL_SECONDS=1800
# Panic Index threshold (0-100) to trigger reassurance alerts
PANIC_THRESHOLD=65

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
